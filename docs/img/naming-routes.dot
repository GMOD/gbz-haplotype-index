// Source for docs/img/naming-routes.svg, which docs/haplotype-index.md embeds.
// Regenerate with: dot -Tsvg docs/img/naming-routes.dot -o docs/img/naming-routes.svg
// Palette matches dataflow.dot.
//
// Main paths only. The anchored route's two fallbacks (a chosen haplotype
// missing from the anchor, a walk that never reaches the window) are prose in
// haplotype-index.md; drawn, their dashed edges crossed both clusters and
// buried the choice the diagram exists to show.
digraph namingroutes {
  rankdir=TB
  bgcolor="white"
  nodesep=0.35
  ranksep=0.32
  newrank=true
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query  [label="query a window of a reference path" fillcolor="#ddf4ff" color="#0969da"]
  choose [label="does the query\npass keep?" shape=diamond style=filled margin="0.02,0.02"]
  how    [label="db.getAlignmentsForRange(path, start, end, {\l  keep: name => name.sample === 'HG002',\l})\lgbz-base-query ... --keep HG002 --keep HG00733#1\l"
          shape=note fontname="Courier" fontsize=9 fillcolor="#fff8c5" color="#9a6700"]
  { rank=same; choose; how }
  choose -> how [style=dotted arrowhead=none]
  out    [label="each walk labelled\nsample#haplotype" fillcolor="#ddf4ff" color="#0969da"]

  legend [shape=plaintext style="" margin=0 label=<
    <table border="1" color="#d0d7de" cellborder="0" cellspacing="4" cellpadding="2" style="rounded">
      <tr><td border="1" bgcolor="#f6f8fa" color="#57606a" width="14"></td><td align="left">reads graph.gbz.db</td></tr>
      <tr><td border="1" bgcolor="#dafbe1" color="#1a7f37" width="14"></td><td align="left">reads the sidecar graph.haplotype-index.db</td></tr>
      <tr><td border="1" bgcolor="white" color="#57606a" width="14"></td><td align="left">in memory</td></tr>
    </table>>]
  { rank=same; query; legend }

  query -> choose

  subgraph cluster_sampled {
    label="Sampled route\nthe cost grows with the number\nof haplotypes in the window"
    labelloc="t"
    labeljust="l"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    s1 [label="extract every walk through the window"]
    s2 [label="identify each walk from a sample it passes\nHaplotypeSamples" fillcolor="#dafbe1" color="#1a7f37"]
    s3 [label="with keep, drop the haplotypes not chosen" fillcolor="white"]
    s1 -> s2 -> s3
  }

  subgraph cluster_anchored {
    label="Anchored route\nthe cost grows with the number\nof haplotypes chosen"
    labelloc="t"
    labeljust="r"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    a1 [label="find the anchor node before the window\nHaplotypeAnchors" fillcolor="#dafbe1" color="#1a7f37"]
    a2 [label="list the haplotypes passing the anchor node\nHaplotypeSamples" fillcolor="#dafbe1" color="#1a7f37"]
    a2b [label="keep the chosen haplotypes" fillcolor="white"]
    a3 [label="follow each chosen walk from the\nanchor through the window"]
    a1 -> a2 -> a2b -> a3
  }

  choose -> s1 [label=" no "]
  choose -> a1 [label=" yes "]
  s3 -> out
  a3 -> out
}
