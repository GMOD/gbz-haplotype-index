// Source for docs/img/naming-routes.svg, which docs/haplotype-index.md embeds.
// Regenerate with: dot -Tsvg docs/img/naming-routes.dot -o docs/img/naming-routes.svg
// Palette matches dataflow.dot.
//
// Main paths only. The keep route's checks are one decision node here, and
// haplotype-index.md lists them.
digraph namingroutes {
  rankdir=TB
  bgcolor="white"
  nodesep=0.35
  ranksep=0.32
  newrank=true
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query  [label="query a window of a reference path" fillcolor="#ddf4ff" color="#0969da"]
  choose [label="does the query use\nthe keep option,\n{ keep: name => … }\nor --keep NAME?" shape=diamond style=filled margin="0.02,0.02"]
  how    [label="db.getAlignmentsForRange(path, start, end, {\l  keep: name => name.sample === 'HG002',\l})\lgbz-base-query ... --keep HG002 --keep HG00733#1\l"
          shape=note fontname="Courier" fontsize=9 fillcolor="#fff8c5" color="#9a6700"]
  { rank=same; choose; how }
  choose -> how [style=dotted arrowhead=none]
  out    [label="each walk labelled\nsample#haplotype" fillcolor="#ddf4ff" color="#0969da"]

  legend [shape=plaintext style="" margin=0 label=<
    <table border="1" color="#d0d7de" cellborder="0" cellspacing="4" cellpadding="2" style="rounded">
      <tr><td border="1" bgcolor="#f6f8fa" color="#57606a" width="14"></td><td align="left">reads graph.gbz.db</td></tr>
      <tr><td border="1" bgcolor="#dafbe1" color="#1a7f37" width="14"></td><td align="left">reads the sidecar graph.haplotype-index.db</td></tr>
      <tr><td border="1" bgcolor="white" color="#57606a" width="14"></td><td align="left">in memory</td></tr>
    </table>>]
  { rank=same; query; legend }

  query -> choose

  subgraph cluster_sampled {
    label="Sampled route\nthe cost grows with the number\nof haplotypes in the window"
    labelloc="t"
    labeljust="l"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    s1 [label="extract every walk through the window"]
    s2 [label="identify each walk from a sample it passes\nHaplotypeSamples" fillcolor="#dafbe1" color="#1a7f37"]
    s3 [label="if the query uses the keep option,\ndrop the walks where keep(name) is false" fillcolor="white"]
    s1 -> s2 -> s3
  }

  subgraph cluster_keep {
    label="Keep route\nthe cost grows with\nthe haplotypes chosen"
    labelloc="t"
    labeljust="l"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    k1 [label="build the subgraph the sampled\nroute builds for the window"]
    k2 [label="read the node lists and stray rows of the\nbins the window touches, and every visit\nto the anchors near those bins\nHaplotypeBinNodes, HaplotypeStrays,\nHaplotypeAnchors, HaplotypeSamples" fillcolor="#dafbe1" color="#1a7f37"]
    k3 [label="is every node of the subgraph\nin a node list, or in a snarl\nthat the stray rows cover?" shape=diamond style=filled margin="0.02,0.02"]
    k4 [label="walk each haplotype where keep(name)\nis true between its visits to adjacent\nanchors, and along its stray rows"]
    k5 [label="does each sample of a chosen\nhaplotype on the window's nodes\nlie in a piece the walks found?" shape=diamond style=filled margin="0.02,0.02"]
    k1 -> k2 -> k3
    k3 -> k4 [label=" yes "]
    k4 -> k5
  }

  choose -> s1 [label=" no "]
  choose -> k1 [label=" yes "]
  k3 -> s1 [label=" no " constraint=false]
  k5 -> s1 [label=" no " constraint=false]
  s3 -> out
  k5 -> out [label=" yes "]
}
